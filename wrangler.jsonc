{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Fresh codebam.ca instance. SERVER_NAME drives MXIDs (@user:codebam.ca),
	// discovery base_url, OAuth issuer and federation signatures.
	"name": "matrix-worker-codebam",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "matrix-db-codebam",
			"database_id": "02928f6d-13b2-4938-bd6b-86120b8df99a"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "e96c8615f19348eebd4de52d0553fe93"
		},
		{
			"binding": "DEVICE_KEYS",
			"id": "a7d9aca53cee486f8330fe75f81b558b"
		},
		{
			"binding": "CACHE",
			"id": "5d1b24e51b7a4f99a21f2619ea61742f"
		},
		{
			"binding": "CROSS_SIGNING_KEYS",
			"id": "a02d8bcced28443d9d258d0a4eb83426"
		},
		{
			"binding": "ACCOUNT_DATA",
			"id": "63949e48e6664978812eef89785e46e4"
		},
		{
			"binding": "ONE_TIME_KEYS",
			"id": "b142990abe7347839995ba89035fb0e3"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "matrix-media-codebam-ca"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "RoomDurableObject"
			},
			{
				"name": "SYNC",
				"class_name": "SyncDurableObject"
			},
			{
				"name": "FEDERATION",
				"class_name": "FederationDurableObject"
			},
			{
				"name": "CALL_ROOMS",
				"class_name": "CallRoomDurableObject"
			},
			{
				"name": "ADMIN",
				"class_name": "AdminDurableObject"
			},
			{
				"name": "USER_KEYS",
				"class_name": "UserKeysDurableObject"
			},
			{
				"name": "PUSH",
				"class_name": "PushDurableObject"
			},
			{
				"name": "RATE_LIMIT",
				"class_name": "RateLimitDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RoomDurableObject",
				"SyncDurableObject",
				"FederationDurableObject"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"CallRoomDurableObject"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"AdminDurableObject"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"UserKeysDurableObject"
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"PushDurableObject"
			]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": [
				"RateLimitDurableObject"
			]
		}
	],
	"vars": {
		"SERVER_NAME": "codebam.ca",
		"SERVER_VERSION": "0.1.0",
		"REGISTRATION_REQUIRE_TOKEN": "true"
	},
	// Path routes, not a custom domain: codebam.ca stays owned by the
	// codebam-ca website Worker. Cloudflare evaluates the most specific
	// matching route first, so these Matrix paths win over the website's
	// hostname-wide custom domain and everything else falls through to it.
	// No /matrix prefix: federation and discovery require root-level paths.
	// Every pattern ends in a wildcard: an exact-path route (no trailing *)
	// stops matching once a query string is present and falls through to the
	// website, which broke /admin?action=… from Element's manage-device link.
	"routes": [
		"codebam.ca/_matrix/*",
		"codebam.ca/oauth/*",
		"codebam.ca/.well-known/matrix/*",
		"codebam.ca/.well-known/openid-configuration*",
		"codebam.ca/.well-known/jwks.json*",
		"codebam.ca/admin*",
		"codebam.ca/_synapse/*",
		"codebam.ca/auth/oidc/*",
		"codebam.ca/calls/*",
		"codebam.ca/health*"
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"workflows": [
		{
			"name": "room-join-workflow-codebam",
			"binding": "ROOM_JOIN_WORKFLOW",
			"class_name": "RoomJoinWorkflow"
		},
		{
			"name": "push-notification-workflow-codebam",
			"binding": "PUSH_NOTIFICATION_WORKFLOW",
			"class_name": "PushNotificationWorkflow"
		}
	]
}
